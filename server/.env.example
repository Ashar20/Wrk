# Created by `npm run setup:devnet`. Devnet only.
WRK_RPC_URL=https://api.devnet.solana.com
WRK_CLUSTER=devnet
# The reward token. On devnet this is a free test token the validator can mint.
WRK_MINT=
# Path to the validator's key file: fee payer, mint authority, and the only key that can accept or reject takes.
WRK_TREASURY_KEYPAIR=
# Optional: real emailed sign-in codes (otherwise they print on this console)
RESEND_API_KEY=
WRK_MAIL_FROM=
