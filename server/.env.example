# Created by `npm run setup:devnet`. Devnet only.
WRK_RPC_URL=https://api.devnet.solana.com
WRK_CLUSTER=devnet
# The reward token. On devnet this is a free test token the validator can mint.
WRK_MINT=
# Path to the validator's key file: fee payer, mint authority, and the only key that can accept or reject takes.
WRK_TREASURY_KEYPAIR=
# Optional: real emailed sign-in codes (otherwise they print on this console)
RESEND_API_KEY=
WRK_MAIL_FROM=
# SHA-256 fingerprints (hex) of the certificates Wrk is signed with, comma separated. A take only counts as "attested"
# when it comes from an app signed by one of these. Get yours with: apksigner verify --print-certs <apk>
WRK_APP_CERT_SHA256=
# Set to 1 to refuse every take that doesn't come from a verified phone.
WRK_REQUIRE_DEVICE=
